    {
      "name": "Movies",
      "item": [
        {
          "name": "Create Movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "pm.environment.set('movieId', jsonData.data.id);",
                  "console.log('movieId saved:', jsonData.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"synopsis\": \"A thief who steals corporate secrets through the use of dream-sharing technology.\",\n  \"duration\": 148,\n  \"genre\": \"SCIENCE_FICTION\",\n  \"rating\": \"PG_13\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/movies",
              "host": ["{{base_url}}"],
              "path": ["api", "movies"]
            }
          },
          "response": []
        },
        {
          "name": "List Movies (Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/movies?genre=SCIENCE_FICTION&rating=PG_13&page=0&size=10&sort=title,asc",
              "host": ["{{base_url}}"],
              "path": ["api", "movies"],
              "query": [
                {
                  "key": "genre",
                  "value": "SCIENCE_FICTION"
                },
                {
                  "key": "rating",
                  "value": "PG_13"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "title,asc"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Movie by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/movies/{{movieId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "movies", "{{movieId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Movie",
